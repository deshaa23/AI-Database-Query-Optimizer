APP_NAME=AI Database Query Optimizer
APP_ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Local PostgreSQL settings. Replace the password with a local development secret.
POSTGRES_DB=query_optimizer
POSTGRES_USER=query_optimizer
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional AI reasoning provider. Required only for live OpenAI analysis.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=

# Controlled benchmark settings.
BENCHMARK_TIMEOUT_MS=30000
BENCHMARK_REPETITIONS=5
BENCHMARK_WARMUP_RUNS=1
BENCHMARK_MIN_IMPROVEMENT_PERCENT=5.0
